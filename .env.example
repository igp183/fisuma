# /calendario

# Horários de aulas (1º/2º/3º ano) — vêm da API pública da Universidade da
# Madeira. Não precisa de chave. O curso é configurável (default: 23360, Física).
UMA_CURSO_ID=23360

# Calendário FISUMa — Google Calendar público (eventos da associação).
GOOGLE_CALENDAR_API_KEY=
GOOGLE_CALENDAR_ID_FISUMA=
